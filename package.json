{
	"name": "obsidian-doomesque-settings",
	"version": "1.1.8",
	"description": "Obsidian plugin to customize palettes, typography, and layout in the DoomEsque theme.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild test/doomSettings.test.ts --bundle --platform=node --format=cjs | node"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"doomesque",
		"doom-emacs",
		"theme",
		"theme-settings",
		"hover-preview"
	],
	"author": "blursedperf",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/blursedperf/obsidian-doomesque-settings.git"
	},
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@types/node": "^20.11.0",
		"esbuild": "0.21.5",
		"obsidian": "^1.5.7",
		"tslib": "2.6.2",
		"typescript": "5.4.5"
	}
}
